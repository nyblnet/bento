<?xml version="1.0" encoding="utf-8"?>
<!-- The search box. A panel with a hairline, not the framework EditText's
     underline — the underline is the single most "unstyled Android" element on
     the screen and reads as a form field rather than a search surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/panel" />
    <stroke android:width="1dp" android:color="@color/line" />
    <corners android:radius="@dimen/radius" />
</shape>
