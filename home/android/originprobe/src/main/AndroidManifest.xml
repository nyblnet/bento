<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: the probe sends nothing anywhere. Credential
         Manager and the provider (Google Password Manager) do their own
         network work, including fetching the relying party's assetlinks.json. -->
    <application
        android:label="Passkey origin probe"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
