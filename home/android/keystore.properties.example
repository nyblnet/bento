# Release signing for Play. Copy to keystore.properties (gitignored) and fill in.
#
# A keystore path and its passwords identify a publisher, so none of this is ever
# committed — the same rule as BENTO_TEAM_ID on iOS, which comes from the
# environment at project-generation time.
#
# Create a keystore with:
#   keytool -genkeypair -v -keystore ~/.bento/bento-tray.jks \
#           -alias bento-tray -keyalg RSA -keysize 4096 -validity 10000
#
# Keep it offline and backed up: Play identifies an app by its signing key, and
# losing it means never shipping an update to this listing again.

storeFile=/Users/you/.bento/bento-tray.jks
storePassword=
keyAlias=bento-tray
keyPassword=
