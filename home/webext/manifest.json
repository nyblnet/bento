{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_appDesc__",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "notifications",
    "sidePanel",
    "storage",
    "downloads",
    "downloads.ui"
  ],
  "optional_permissions": [
    "history"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "src/home.html#settings",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.bento.html"
      ],
      "all_frames": false,
      "js": [
        "src/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "file:///*.bento.html"
      ],
      "all_frames": false,
      "js": [
        "src/relay.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "bento/home \u2014 your documents",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "Open the bento/home panel beside this document"
    }
  },
  "default_locale": "en",
  "host_permissions": [
    "file:///*"
  ],
  "sandbox": {
    "pages": [
      "src/serve/sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-modals allow-popups allow-popups-to-escape-sandbox; default-src 'none'; script-src 'self' blob:; style-src 'unsafe-inline'; img-src data: blob: https:; media-src data: blob: https:; font-src data: blob:; connect-src https://bento.page https://sync.bento.page wss://sync.bento.page; frame-src https:; object-src 'none'; base-uri 'none'; form-action 'none'; worker-src 'none'"
  }
}
