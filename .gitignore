# dependencies & build output.
# No trailing slash on node_modules: `node_modules/` matches DIRECTORIES only,
# so a node_modules SYMLINK (what you get pointing a worktree at another
# checkout's deps) slipped past it and was committed once. Match both forms.
node_modules
dist/
dist-single/

# local test decks — never committed (may contain confidential content)
testing/

# os cruft
.DS_Store
*.tsbuildinfo

# wrangler local dev state (cache + captured request metadata, R2/KV blobs) —
# never commit; the daemon subdir lacked its own ignore and leaked one in
.wrangler/
# site/ is the fully GENERATED deploy tree (release.mjs assembles it, then
# scripts/publish-site.mjs mirrors it into the bento-site repo). Never edit it
# by hand — the authored sources live in site-src/ (landing/guestbook/404/qr
# pages, tracked) and scripts/ (gallery decks). Edit those, then rebuild.
site/
# A RENAMED copy of that tree slips straight past the rule above, which is how
# site.stale-1.0.11/ — 48 files and 14MB of built shells — was committed by
# accident. Keeping a snapshot during a release is fine; commit it, never.
/site.*/
working/
.dev.vars

# secrets, matched by FILENAME anywhere in the tree. The directory rules above
# (working/, the daemon's own .dev.vars) only hold while the secret stays put,
# and this project has twice shipped what a path-scoped rule stopped covering
# (the built shell under the renamed tray dir, below). Here the escape is a
# flag, not a rename: `scripts/build-guestbook.mjs --out <anywhere>` writes
# guestbook-owner-keys.json — the room's owner ECDSA private key — next to
# --out, so one invocation outside working/ hands a `git add -A` the key.
guestbook-owner-keys.json
guestbook-admin-key.txt
release-key.json
*.key
*.pem
.env
.env.*
.dev.vars.*

# make-og.mjs intermediate (the SVG rasterised into site-src/og.png)
scripts/.cache/

*.xcuserdatad/

# tray: generated by xcodegen and by the slides build. The paths moved when
# tray/BentoTray/ was renamed to home/ios/, which silently unignored them and
# let a broad `git add` sweep them into an unrelated PR. That happened twice —
# an earlier ios/BentoHost/ copy carried a 587KB built shell in main until
# 2026-07-27 — so these are matched ANYWHERE, not at a fixed path: a future
# rename must not be able to unignore them again.
**/*.xcodeproj/
**/Resources/starter.bento.html

# GIT WORKTREES CHECKED OUT INSIDE THE REPO. `.claude/` is a tracked directory
# (launch.json lives there), so a worktree under it is an entire second
# checkout sitting in `git status` — one broad `git add` sweeps thousands of
# files, including another branch's build output, into an unrelated commit.
#
# This was ignored only in `.git/info/exclude`, which is per-machine and never
# committed: it protected one laptop and nobody else's clone.
#
# It is NOT what deletes these directories — `git clean -fdx` reports "skip
# repository" for a nested checkout and needs `-ff` to touch one. Ignoring is
# about not COMMITTING them.
.claude/worktrees/

# home/android: Gradle's own state, and the two files that hold local identity.
# Matched by FILENAME for the same reason as the secrets above — `local.properties`
# carries an absolute SDK path and `keystore.properties` the release signing
# passwords, and neither may become committable by moving a directory.
local.properties
keystore.properties
.gradle/
.kotlin/
home/android/build/
home/android/*/build/

# per-session git worktrees (docs/PARALLEL-WORK.md §2.1). Inside the repo on
# purpose: ~/.zshrc picks the personal gh account by directory, and /tmp gets
# reaped — seven worktrees were lost from it in one day.
.worktrees/

# Local agent/harness config. Populated by tooling outside this repo; the repo
# itself ships none, so anything here is a working copy, not a shared contract.
.claude/agents
.claude/commands/team
