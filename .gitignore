# dependencies & build output.
# No trailing slash on node_modules: `node_modules/` matches DIRECTORIES only,
# so a node_modules SYMLINK (what you get pointing a worktree at another
# checkout's deps) slipped past it and was committed once. Match both forms.
node_modules
dist/
dist-single/

# local test decks — never committed (may contain confidential content)
testing/

# os cruft
.DS_Store
*.tsbuildinfo

# wrangler local dev state (cache + captured request metadata, R2/KV blobs) —
# never commit; the daemon subdir lacked its own ignore and leaked one in
.wrangler/
# site/ is the fully GENERATED deploy tree (release.mjs assembles it, then
# scripts/publish-site.mjs mirrors it into the bento-site repo). Never edit it
# by hand — the authored sources live in site-src/ (landing/guestbook/404/qr
# pages, tracked) and scripts/ (gallery decks). Edit those, then rebuild.
site/
working/
.dev.vars

# secrets, matched by FILENAME anywhere in the tree. The directory rules above
# (working/, the daemon's own .dev.vars) only hold while the secret stays put,
# and this project has twice shipped what a path-scoped rule stopped covering
# (the built shell under the renamed tray dir, below). Here the escape is a
# flag, not a rename: `scripts/build-guestbook.mjs --out <anywhere>` writes
# guestbook-owner-keys.json — the room's owner ECDSA private key — next to
# --out, so one invocation outside working/ hands a `git add -A` the key.
guestbook-owner-keys.json
guestbook-admin-key.txt
release-key.json
*.key
*.pem
.env
.env.*
.dev.vars.*

# make-og.mjs intermediate (the SVG rasterised into site-src/og.png)
scripts/.cache/

# tray: generated by xcodegen and by the slides build. The paths moved when
# tray/BentoTray/ was renamed to tray/ios/, which silently unignored them and
# let a broad `git add` sweep them into an unrelated PR. That happened twice —
# an earlier ios/BentoHost/ copy carried a 587KB built shell in main until
# 2026-07-27 — so these are matched ANYWHERE, not at a fixed path: a future
# rename must not be able to unignore them again.
**/*.xcodeproj/
**/Resources/starter.bento.html
