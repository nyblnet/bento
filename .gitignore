# dependencies & build output.
# No trailing slash on node_modules: `node_modules/` matches DIRECTORIES only,
# so a node_modules SYMLINK (what you get pointing a worktree at another
# checkout's deps) slipped past it and was committed once. Match both forms.
node_modules
dist/
dist-single/

# locally-downloaded MathJax engine for dev/testing only (fetched from cdnjs;
# in production it is served from bento.page/vendor and NEVER bundled) — see
# slides/src/mathjax.ts. Do not commit the 2MB blob.
slides/public/vendor/

# local test decks — never committed (may contain confidential content)
testing/

# os cruft
.DS_Store
*.tsbuildinfo

# wrangler local dev state (cache + captured request metadata, R2/KV blobs) —
# never commit; the daemon subdir lacked its own ignore and leaked one in
.wrangler/
# site/ is the fully GENERATED deploy tree (release.mjs assembles it, then
# scripts/publish-site.mjs mirrors it into the bento-site repo). Never edit it
# by hand — the authored sources live in site-src/ (landing/guestbook/404/qr
# pages, tracked) and scripts/ (gallery decks). Edit those, then rebuild.
site/
working/
.dev.vars

# make-og.mjs intermediate (the SVG rasterised into site-src/og.png)
scripts/.cache/
