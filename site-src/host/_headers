# bento.page response headers (Cloudflare Workers static assets).
# They reproduce what the site served on GitHub Pages. Shipped decks opened
# from file:// fetch the release channel cross-origin, so
# Access-Control-Allow-Origin is load-bearing: never remove it. Security
# headers come later, deliberately, not as a side effect of a host move.
# A header set by two matching rules is JOINED with a comma, so ACAO and
# Cache-Control appear under /* only.
/*
  Access-Control-Allow-Origin: *
  Cache-Control: max-age=600

/releases/:app/manifest.json
  Content-Type: application/json; charset=utf-8
/releases/:app/history.json
  Content-Type: application/json; charset=utf-8
/releases/:app/packs.json
  Content-Type: application/json; charset=utf-8
/releases/:app/packs/:pack
  Content-Type: application/json; charset=utf-8
/schema/:file
  Content-Type: application/json; charset=utf-8

/skills/bento-slides.zip
  Content-Type: application/x-zip-compressed

# Files with no extension get no Content-Type from Workers; GitHub Pages sent
# octet-stream (LICENSE downloads rather than renders, as it always has).
/LICENSE
  Content-Type: application/octet-stream
/CNAME
  Content-Type: application/octet-stream
/.nojekyll
  Content-Type: application/octet-stream
