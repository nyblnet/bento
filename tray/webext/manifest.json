{
  "manifest_version": 3,
  "name": "Bento Tray",
  "version": "1.0.0",
  "description": "Save a Bento document back to the file you opened, without a destination prompt.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "notifications",
    "sidePanel",
    "storage"
  ],
  "optional_permissions": [
    "history"
  ],
  "options_page": "src/home.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.bento.html"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "file:///*.bento.html"
      ],
      "js": [
        "src/relay.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Bento Tray \u2014 your documents",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "Open the Bento Tray panel beside this document"
    }
  }
}
