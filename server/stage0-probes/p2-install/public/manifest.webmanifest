{
  "name": "Bento stage-0 probe P2 (install)",
  "short_name": "Probe P2",
  "description": "A measurement probe: opens, edits and saves an HTML file through the installed-app file APIs.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfaf7",
  "theme_color": "#b4532a",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    { "action": "/", "accept": { "text/html": [".html", ".htm"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [ { "name": "file", "accept": ["text/html", ".html", ".htm"] } ]
    }
  }
}
